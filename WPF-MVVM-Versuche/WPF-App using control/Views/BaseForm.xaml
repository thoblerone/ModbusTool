<catel:Window x:Class="ModbusWpf.Common.Views.BaseForm"
        xmlns:catel="http://schemas.catelproject.com"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ModbusWpf.Common.Views"
        xmlns:viewModels="clr-namespace:ModbusWpf.Common.ViewModels"
        xmlns:converters="clr-namespace:ModbusWpf.Common.Converters"
        xmlns:common="clr-namespace:Modbus.Common;assembly=Modbus.Common"
        xmlns:cc="clr-namespace:ModbusWpf.CustomControl;assembly=ModbusWpf.CustomControl"
        mc:Ignorable="d"
        Title="BaseForm" Height="940" Width="885"
        d:DataContext="{d:DesignInstance Type=viewModels:BaseFormViewModel, IsDesignTimeCreatable=True}"
        >
    <catel:Window.Resources>
        <ResourceDictionary>
            <converters:EnumBooleanConverter x:Key="EnumBooleanConverter" />
            <converters:IpAddressStringConverter x:Key="IpAdressStringConverter" />
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="6"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            </Style>
            <Style TargetType="cc:IPTextBox">
                <Setter Property="Margin" Value="6" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="6" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="6" />
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            </Style>
            <Style TargetType="Label">
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            </Style>
        </ResourceDictionary>
    </catel:Window.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <GroupBox Header="Communication" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Mode" Grid.Column="0" Padding="12">
                    <StackPanel Orientation="Vertical" >
                        <RadioButton GroupName="Mode" Content="TCP" 
                                     IsChecked="{Binding CommunicationMode, UpdateSourceTrigger=PropertyChanged, ConverterParameter={x:Static common:CommunicationMode.TCP}, Converter={StaticResource EnumBooleanConverter}}"/>
                        <RadioButton GroupName="Mode" Content="UDP" 
                                     IsChecked="{Binding CommunicationMode, UpdateSourceTrigger=PropertyChanged, ConverterParameter={x:Static common:CommunicationMode.UDP}, Converter={StaticResource EnumBooleanConverter}}"/>
                        <RadioButton GroupName="Mode" Content="RTU" 
                                     IsChecked="{Binding CommunicationMode, UpdateSourceTrigger=PropertyChanged, ConverterParameter={x:Static common:CommunicationMode.RTU}, Converter={StaticResource EnumBooleanConverter}}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="TCP" Grid.Column="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Port:" Grid.Column="0" Grid.Row="0"/>
                        <Label Content="IP Address:" Grid.Column="0" Grid.Row="1"/>
                        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding TCPPort}" />
                        <cc:IPTextBox Grid.Column="1" Grid.Row="1" Address="{Binding IPAddress, Converter={StaticResource IpAdressStringConverter}}" Margin="6"/>
                    </Grid>
                </GroupBox>
                <GroupBox Header="RTU" Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Port Name:" />
                        <TextBox Grid.Row="0" Grid.Column="1" />
                        <Label Grid.Row="1" Grid.Column="0" Content="Baud:" />
                        <TextBox Grid.Row="1" Grid.Column="1" />
                        <Label Grid.Row="2" Grid.Column="0" Content="Parity:" />
                        <TextBox Grid.Row="2" Grid.Column="1" />
                        <Label Grid.Row="0" Grid.Column="3" Content="Data Bits:" />
                        <TextBox Grid.Row="0" Grid.Column="4" />
                        <Label Grid.Row="1" Grid.Column="3" Content="Stop Bits:" />
                        <TextBox Grid.Row="1" Grid.Column="4" />
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
        <StackPanel VerticalAlignment="Bottom" Grid.Row="0" Grid.Column="4">
        <GroupBox Header="Buy me a coffee" >
                <Button >
                    <Image Source="btn_donateCC_LG.gif" />
                </Button>
        </GroupBox>
        </StackPanel>
        <GroupBox Header="New Tab Display Format"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
            <WrapPanel Orientation="Horizontal" Margin="12">
                <WrapPanel Orientation="Vertical">
                    <RadioButton GroupName="DisplayFormat" Content="LED" Margin="6"
                                 IsChecked="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged, ConverterParameter={x:Static common:DisplayFormat.LED}, Converter={StaticResource EnumBooleanConverter}}"/>
                    <RadioButton GroupName="DisplayFormat" Content="Binary" Margin="6" 
                                 IsChecked="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged, ConverterParameter={x:Static common:DisplayFormat.Binary}, Converter={StaticResource EnumBooleanConverter}}"/>
                    <RadioButton GroupName="DisplayFormat" Content="Hex" Margin="6" 
                                 IsChecked="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged, ConverterParameter={x:Static common:DisplayFormat.Hex}, Converter={StaticResource EnumBooleanConverter}}"/>
                </WrapPanel>
                <WrapPanel Orientation="Vertical">
                    <RadioButton GroupName="DisplayFormat" Content="Integer" Margin="6" 
                                 IsChecked="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged, ConverterParameter={x:Static common:DisplayFormat.Integer}, Converter={StaticResource EnumBooleanConverter}}"/>
                    <RadioButton GroupName="DisplayFormat" Content="FloatReverse" Margin="6" 
                                 IsChecked="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged, ConverterParameter={x:Static common:DisplayFormat.FloatReverse}, Converter={StaticResource EnumBooleanConverter}}"/>
                </WrapPanel>
            </WrapPanel>
        </GroupBox>
        <GroupBox Header="Slave Settings" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="Slave ID:" Grid.Row="0" Grid.Column="0" />
                    <TextBox Grid.Row="0" Grid.Column="1" MinWidth="30" Text="{Binding SlaveId}"/>
                    <Label Content="Slave Delay (ms):" Grid.Row="1" Grid.Column="0" />
                    <TextBox Grid.Row="1" Grid.Column="1" MinWidth="30" Text="{Binding SlaveDelay}" />
                    <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical">
                        <Button Content="Import ..." />
                        <Button Content="Export ..." />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </GroupBox>
        <TabControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"></TabControl>
        <GroupBox Header="Communication Log" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel  Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Button Content="Pause" Margin="3" Padding="6" />
                    <Button Content="Clear" Margin="3" Padding="6" />
                </StackPanel>
                <ListBox Grid.Row="1"
                    x:Name="listBoxCommLog"
                    Background ="Black"
                    Foreground="LimeGreen"
                    />
            </Grid></GroupBox>
    </Grid>
</catel:Window>
