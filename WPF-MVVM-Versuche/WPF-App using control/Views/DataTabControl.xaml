<controls:UserControl x:Class="WPF_App_using_control.Views.DataTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_App_using_control.Views"
             xmlns:controls="http://schemas.catelproject.com"
             xmlns:catelMvvm="clr-namespace:Catel;assembly=Catel.MVVM"
             xmlns:catelCore="clr-namespace:Catel;assembly=Catel.Core"
             xmlns:viewModels="clr-namespace:WPF_App_using_control.ViewModels"
             xmlns:cc="clr-namespace:TemplatedCustomControl;assembly=TemplatedCustomControl"
             xmlns:helpers="clr-namespace:WPF_App_using_control.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:DataTabControlViewModel, IsDesignTimeCreatable=True}"
             >
    <controls:UserControl.Resources>
        <ResourceDictionary>
            <controls:BooleanToCollapsingVisibilityConverter x:Key="BooleanToCollapsingVisibilityConverter" />

            <DataTemplate x:Key="LedTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" MinWidth="70" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding RegisterNumber}" />
                        <TextBlock Text="{Binding CoilNumber, StringFormat={}(Coil {0}):}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <cc:LedBulb VerticalAlignment="Center"
                                CheckedColor="Green"
                                UncheckedColor="DarkGray"
                                IsChecked="{Binding BoolValue}" 
                                HorizontalAlignment="Left"
                                Height="14" 
                                />
                    <TextBlock Text="(Led)" FontSize="8" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="UshortTemplate">
                <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                    <Label Content="{Binding RegisterNumber}" ContentStringFormat="{}{0}:" MinWidth="40" HorizontalContentAlignment="Right"/>
                    <cc:ReturnKeyTextBox 
                        Text="{Binding TargetRegisterValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                        Margin="12,0,0,0" 
                        MinWidth="40" />
                    <TextBlock Text="(Ushort)" FontSize="8" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="BinaryTemplate">
                <StackPanel Orientation="Horizontal" Margin="6,0,6,6" >
                    <Label 
                        Content="{Binding RegisterNumber}" 
                        ContentStringFormat="{}{0}:"
                        MinWidth="40" 
                        HorizontalContentAlignment="Right"
                        VerticalContentAlignment="Center"/>
                    <cc:ReturnKeyTextBox Text="{Binding BinaryString}" 
                                         Margin="6,0,0,0" />
                    <TextBlock Text="(binary)" FontSize="8" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="HexTemplate">
                <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                    <Label Content="{Binding RegisterNumber}" ContentStringFormat="{}{0}:" MinWidth="40" HorizontalContentAlignment="Right"/>
                    <cc:ReturnKeyTextBox 
                        Text="{Binding HexString, 
                                        Mode=TwoWay, 
                                        UpdateSourceTrigger=LostFocus,
                                        StringFormat={}0x{0:x4}}"
                        Margin="12,0,0,0" MinWidth="50" />
                    <TextBlock Text="(Hex)" FontSize="8" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="FloatReverseTemplate">
                <StackPanel Orientation="Horizontal" Margin="6,0,6,6" >
                    <Label Content="{Binding RegisterNumber}" ContentStringFormat="{}{0}:" MinWidth="40" HorizontalContentAlignment="Right"/>
                    <cc:ReturnKeyTextBox MinWidth="80"
                                         Text="{Binding FloatReverseString}" Margin="6,0,0,0"/>
                    <TextBlock Text="(rFloat)" FontSize="8" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>

            <helpers:RegisterDisplayTemplateSelector 
                x:Key="RegisterDisplayTemplateSelector"
                LedTemplate="{StaticResource LedTemplate}"
                BinaryTemplate="{StaticResource BinaryTemplate}"
                FloatReverseTemplate="{StaticResource FloatReverseTemplate}"
                HexTemplate="{StaticResource HexTemplate}"
                IntegerTemplate="{StaticResource UshortTemplate}"
            />
            
        </ResourceDictionary>
    </controls:UserControl.Resources>
    <GroupBox Margin="6" Header="DataTab" >
        <Grid Margin="0,6,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" >
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Start Address:" MinWidth="100" />
                    <cc:ReturnKeyTextBox VerticalContentAlignment="Center" 
                                             Text="{Binding StartAddress, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                             Margin="12,0,0,0" />
                    <Label Content="Size:" Margin="24,0,0,0" Visibility="{Binding ShowDataLength, Converter={StaticResource BooleanToCollapsingVisibilityConverter}}"/>
                    <cc:ReturnKeyTextBox Text="{Binding DataLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center"
                                 Visibility="{Binding ShowDataLength, Converter={StaticResource BooleanToCollapsingVisibilityConverter}}" 
                                 />
                    <Label Content="Data Format:" Margin="24,0,0,0" Visibility="{Binding ShowDataLength, Converter={StaticResource BooleanToCollapsingVisibilityConverter}}"/>
                    <ComboBox ItemsSource="{Binding DisplayFormatItemSource}" 
                              SelectedValue="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Apply" Margin="24,0,0,0" Padding="12,3,12,3"
                                Command="{Binding ApplyAddressSelectionCommand}"/>
                    <Button Content="Clear" Margin="24,0,0,0" Padding="12,3,12,3"
                                Command="{Binding ClearDataCommand}" />
                </StackPanel>
            </DockPanel>
            <GroupBox Header="Data Elements" Grid.Row="1">
                <DockPanel>
                    <!--<ScrollViewer  VerticalScrollBarVisibility="Disabled">-->
                        <ItemsControl 
                        ItemsSource="{Binding RegisterModels}"
                        ItemTemplateSelector="{StaticResource RegisterDisplayTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" MaxWidth="800" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    <!--</ScrollViewer>-->
                </DockPanel>
            </GroupBox>
        </Grid>
    </GroupBox>
</controls:UserControl>
