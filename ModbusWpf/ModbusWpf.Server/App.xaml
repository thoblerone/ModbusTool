<Application x:Class="ModbusWpf.Server.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModbusWpf.Server"
             xmlns:cc="clr-namespace:ModbusWpf.CustomControl;assembly=ModbusWpf.CustomControl"
             StartupUri="Views/ServerView.xaml">
    <Application.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24" />
        </Style>
        <Style TargetType="{x:Type cc:ReturnKeyTextBox}">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24" />
        </Style>
        <Style TargetType="{x:Type cc:IPTextBox}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type Label}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="Padding" Value="6" />
        </Style>

    </Application.Resources>
</Application>
