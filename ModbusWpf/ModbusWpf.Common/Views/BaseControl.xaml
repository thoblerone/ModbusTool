<catel:UserControl x:Class="ModbusWpf.Common.Views.BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ModbusWpf.Common.Views"
             xmlns:catel="http://schemas.catelproject.com"
             xmlns:converters="clr-namespace:ModbusWpf.Common.Converters"
             xmlns:common="clr-namespace:Modbus.Common;assembly=Modbus.Common"
             xmlns:cc="clr-namespace:ModbusWpf.CustomControl;assembly=ModbusWpf.CustomControl"
             xmlns:ports="clr-namespace:System.IO.Ports;assembly=System"
             xmlns:viewModels="clr-namespace:ModbusWpf.Common.ViewModels"
             xmlns:helpers="clr-namespace:ModbusWpf.Common.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:BaseViewModel}}"
             
             >
    <catel:UserControl.Resources>
        <ResourceDictionary>
            <converters:EnumBooleanConverter x:Key="EnumBooleanConverter" />
            <converters:IpAddressStringConverter x:Key="IpAddressStringConverter" />
            <converters:StartAddressDisplayFormatToHeaderConverter x:Key="StartAddressDisplayFormatToHeaderConverter" />
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="24" />
            </Style>
            <Style TargetType="{x:Type cc:IPTextBox}">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Height" Value="24" />
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="6,0" />
            </Style>
            <Style TargetType="{x:Type Button}" x:Key="MultiLineButtonStyle">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="6" />
            </Style>
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Margin" Value="6" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="{x:Type GroupBox}">
                <Setter Property="BorderBrush" Value="DarkGray" />
                <Setter Property="Padding" Value="6" />
            </Style>
        </ResourceDictionary>
    </catel:UserControl.Resources>
    <catel:UserControl.Background>
        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
    </catel:UserControl.Background>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="635" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <GroupBox Header="Communication" Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Mode" Grid.Column="0" Margin="0,0,6,0"
                          IsEnabled="{Binding HasConnected, Converter={catel:BooleanToOppositeBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                          >
                    <StackPanel Orientation="Vertical" >
                        <RadioButton GroupName="Mode" Content="TCP" 
                                     IsChecked="{Binding CommunicationMode, ConverterParameter={x:Static common:CommunicationMode.TCP}, Converter={StaticResource EnumBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                        <RadioButton GroupName="Mode" Content="UDP" 
                                     IsChecked="{Binding CommunicationMode, ConverterParameter={x:Static common:CommunicationMode.UDP}, Converter={StaticResource EnumBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                        <RadioButton GroupName="Mode" Content="RTU" 
                                     IsChecked="{Binding CommunicationMode, ConverterParameter={x:Static common:CommunicationMode.RTU}, Converter={StaticResource EnumBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="TCP" Grid.Column="1" Margin="0,0,6,0"
                          IsEnabled="{Binding EnableTcpOptions, UpdateSourceTrigger=PropertyChanged}" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Port:" Grid.Column="0" Grid.Row="0"/>
                        <Label Content="IP Address:" Grid.Column="0" Grid.Row="1" Visibility="{Binding IpAddressVisibility}" />
                        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding TcpPort}" HorizontalAlignment="Left"  Width="50"  />
                        <cc:IPTextBox Grid.Column="1" Grid.Row="1" Address="{Binding IpAddress, Converter={StaticResource IpAddressStringConverter}}" Margin="6" Visibility="{Binding IpAddressVisibility}" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="RTU" Grid.Column="2" 
                          IsEnabled="{Binding EnableRtuOptions, UpdateSourceTrigger=PropertyChanged}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Port Name:" />
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                  ItemsSource="{Binding ComPortItemsSource}"
                                  SelectedValue="{Binding PortName, UpdateSourceTrigger=LostFocus}"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="Baud:" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ComPortBaudRates}"
                                  SelectedValue="{Binding Baud}"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="Parity:" />
                        <ComboBox Grid.Row="2" Grid.Column="1" 
                                  SelectedValue="{Binding Parity, UpdateSourceTrigger=LostFocus}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="{x:Static ports:Parity.None}" />
                            <ComboBoxItem Content="{x:Static ports:Parity.Odd}" />
                            <ComboBoxItem Content="{x:Static ports:Parity.Even}" />
                            <ComboBoxItem Content="{x:Static ports:Parity.Mark}" />
                            <ComboBoxItem Content="{x:Static ports:Parity.Space}" />
                        </ComboBox>
                        <Label Grid.Row="0" Grid.Column="3" Content="Data Bits:" />
                        <ComboBox Grid.Row="0" Grid.Column="4" SelectedValuePath="Tag"
                                  SelectedValue="{Binding DataBits, UpdateSourceTrigger=LostFocus}">
                            <ComboBoxItem Content="8 Bits" Tag="8" />
                            <ComboBoxItem Content="7 Bits" Tag="7" />
                        </ComboBox>
                        <Label Grid.Row="1" Grid.Column="3" Content="Stop Bits:" />
                        <ComboBox Grid.Row="1" Grid.Column="4"
                                  SelectedValue="{Binding StopBits, UpdateSourceTrigger=LostFocus}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="{x:Static ports:StopBits.None}" />
                            <ComboBoxItem Content="{x:Static ports:StopBits.One}" />
                            <ComboBoxItem Content="{x:Static ports:StopBits.Two}" />
                            <ComboBoxItem Content="{x:Static ports:StopBits.OnePointFive}" />
                        </ComboBox>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Content="Listen" Visibility="{Binding ServerOptionsVisibility}"
                    Command="{Binding ServerListenCommand}"
                    Padding="0"  Height="24" Width="143" HorizontalAlignment="Right" />
            <Button Grid.Row="0" Content="Connect" Visibility="{Binding ClientOptionsVisibility}" 
                    Command="{Binding ClientListenCommand}"
                    Padding="0"  Height="24" Width="143" HorizontalAlignment="Right" />
            <Button Grid.Row="1" Content="Disconnect" Padding="0" Height="24"
                    Command="{Binding DisconnectCommand}" HorizontalAlignment="Right" Width="143" />

            <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <GroupBox Header="If you find this useful ..." >
                    <Button Command="{Binding DonateCommand}">
                        <Image Source="btn_donateCC_LG.gif" Width="147" Height="47" />
                    </Button>
                </GroupBox>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" Grid.Column="0">
            <GroupBox DockPanel.Dock="Right" Header="Server Settings" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1" 
                  HorizontalAlignment="Right" Margin="0,0,6,0"
                  IsEnabled="{Binding HasConnected, Converter={catel:BooleanToOppositeBooleanConverter}, UpdateSourceTrigger=PropertyChanged}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Server ID:" Grid.Row="0" Grid.Column="0" />
                    <TextBox Grid.Row="0" Grid.Column="1" MinWidth="30" Text="{Binding ServerId}"/>
                    <Label Content="Server Delay (ms):" Grid.Row="1" Grid.Column="0"  Visibility="{Binding ServerOptionsVisibility}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" MinWidth="30" Text="{Binding ServerDelay}"  Visibility="{Binding ServerOptionsVisibility}"/>
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Padding="3,0, 10,0" BorderBrush="{x:Null}"
                            Background="{x:Null}" BorderThickness="0" ToolTipService.ShowOnDisabled="True"
                            ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000" HorizontalAlignment="Center">
                        <Path Data="{Binding IconPath}" HorizontalAlignment="Right" Stretch="Uniform" Width="75" Height="75">
                            <Path.Fill>
                                <LinearGradientBrush>
                                    <GradientStop Color="{Binding IconColor}" Offset="0" />
                                    <GradientStop Color="{DynamicResource {x:Static SystemColors.ControlDarkDarkColorKey}}" Offset="1" />
                                    <LinearGradientBrush.Transform>
                                        <MatrixTransform Matrix="0.75,0,0,0.75,0,0" />
                                    </LinearGradientBrush.Transform>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Border.ToolTip>
                            <ToolTip MaxWidth="450">
                                <TextBlock TextWrapping="Wrap"><Bold>Client/Server Terminology:</Bold><LineBreak />
                            The Modbus Organization replaced 'Master-Slave' with 'Client-Server' in July 2020.<LineBreak />
                            https://www.modbus.org/docs/Client-ServerPR-07-2020-final.docx.pdf <LineBreak />
                            The new Modbus terminology replaces Master with Client, and Slave with Server, 
                            thus a Modbus network has a single client (ex-master) with multiple servers (ex-slaves). 
                            This has caused some confusion as a usual office PC computer network would have a single 
                            server with multiple clients (i.e. PC users), and is the reverse of, for example, Python, 
                            where Master was replaced with Server. <LineBreak/>
                            <Bold>In the case of Modbus, the client (main controller) 
                            is the only device on the network that can initiate a transfer requesting the data, and 
                            the servers (e.g. sensors) are the ones serving the data in response.</Bold></TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>
                </Grid>
            </GroupBox>
            <GroupBox Header="Functions" Grid.Row="1" Grid.Column="0" Visibility="{Binding ClientOptionsVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Command="{Binding ExecuteClientFunctionCommand}" Style="{StaticResource MultiLineButtonStyle}" CommandParameter="{x:Static helpers:ClientFunctions.ReadCoils}" Content="Read coils"/>
                    <Button Grid.Row="0" Grid.Column="1" Command="{Binding ExecuteClientFunctionCommand}" Style="{StaticResource MultiLineButtonStyle}" CommandParameter="{x:Static helpers:ClientFunctions.ReadDiscrete}" Content="Read&#xa;discrete" />
                    <Button Grid.Row="0" Grid.Column="2" Command="{Binding ExecuteClientFunctionCommand}" Style="{StaticResource MultiLineButtonStyle}" CommandParameter="{x:Static helpers:ClientFunctions.ReadHoldingRegister}" Content="Read holding&#xa;register" />
                    <Button Grid.Row="0" Grid.Column="3" Command="{Binding ExecuteClientFunctionCommand}" Style="{StaticResource MultiLineButtonStyle}" CommandParameter="{x:Static helpers:ClientFunctions.ReadInputRegister}" Content="Read input&#xa;register" />
                    <Button Grid.Row="1" Grid.Column="0" Command="{Binding ExecuteClientFunctionCommand}" Style="{StaticResource MultiLineButtonStyle}" CommandParameter="{x:Static helpers:ClientFunctions.WriteSingleCoil}" Content="Write&#xa;single coil" />
                    <Button Grid.Row="1" Grid.Column="1" Command="{Binding ExecuteClientFunctionCommand}" Style="{StaticResource MultiLineButtonStyle}" CommandParameter="{x:Static helpers:ClientFunctions.WriteSingleRegister}" Content="Write single&#xa;register" />
                    <Button Grid.Row="1" Grid.Column="2" Command="{Binding ExecuteClientFunctionCommand}" Style="{StaticResource MultiLineButtonStyle}" CommandParameter="{x:Static helpers:ClientFunctions.WriteMultipleCoils}" Content="Write&#xa;multiple coils" />
                    <Button Grid.Row="1" Grid.Column="3" Command="{Binding ExecuteClientFunctionCommand}" Style="{StaticResource MultiLineButtonStyle}" CommandParameter="{x:Static helpers:ClientFunctions.WriteMultipleRegister}" Content="Write multiple&#xa;register" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Grid.Column="0" Orientation="Horizontal" >
                        <CheckBox Margin="6,0,0,0" IsChecked="{Binding ClientPollingActive}" Content="Poll" VerticalContentAlignment="Center"/>
                        <TextBox Text="{Binding ClientPollInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="50" VerticalAlignment="Center" />
                        <TextBlock Text="ms" Width="50" VerticalAlignment="Center"/>
                    </StackPanel>

                </Grid>

            </GroupBox>
        </DockPanel>
        <GroupBox Header="CSV File I/O" IsEnabled="{Binding HasConnected, Converter={catel:BooleanToOppositeBooleanConverter}, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="197">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                    <Button Content="Import Tab Data ..." Command="{Binding ImportCurrentTabDataCommand}" Style="{StaticResource MultiLineButtonStyle}"/>
                    <Button Content="Export Tab Data ..." Command="{Binding ExportCurrentTabDataCommand}" Style="{StaticResource MultiLineButtonStyle}"/>
                </StackPanel>
            </GroupBox>
        <TabControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding DataTabItems}"
                    SelectedItem="{Binding SelectedDataTabItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsSynchronizedWithCurrentItem="True"
                    Margin="0,6,0,0">
            <TabControl.ItemTemplate>
                <!-- this is the header template-->
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Button Padding="0" Height="10" Width="10" 
                                VerticalAlignment="Top" Margin="0,0,3,0" Background="Red" 
                                Command="{Binding DataContext.CloseDataTabItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BaseControl}}}" 
                                CommandParameter="{Binding }">
                            <Path Height="6" Width="6" Stretch="Uniform" Tag="M0,0L32,0 32,32 0,32z" 
                                  Data="M 0.47265625 -0.45117188 L -0.45117188 0.47265625 L 2.0839844 3.0078125 L -0.43554688 5.5371094 L 0.48046875 6.4511719 L 3.0019531 3.9257812 L 5.5292969 6.4511719 L 6.4511719 5.5292969 L 3.9257812 3.0019531 L 6.4296875 0.49414062 L 5.5078125 -0.42773438 L 3.0058594 2.0839844 L 0.47265625 -0.45117188 z"
                                  Fill="White" />
                        </Button>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StartAddressDisplayFormatToHeaderConverter}" UpdateSourceTrigger="PropertyChanged">
                                    <Binding Path="DisplayFormat" UpdateSourceTrigger="PropertyChanged"/>
                                    <Binding Path="StartAddress" UpdateSourceTrigger="PropertyChanged"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding DisplayFormat}" FontSize="8" Margin="3,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <!-- this is the body of the TabItem template-->
                <DataTemplate>
                    <local:DataTabControl />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <GroupBox Header="Communication Log" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" >
                    <ToggleButton IsChecked="{Binding LogPaused}" Padding="6" Margin="6,0">
                        <ToggleButton.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="Content" Value="Pause" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="Resume" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button Content="Clear" Margin="6,0,0,0"  Command="{Binding LogClearCommand}" />
                </StackPanel>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding CommLogEntries}"
                         SelectedIndex="{Binding SelectedCommLogIndex}"
                    Background ="Black"
                    Foreground="LimeGreen" SelectionChanged="ListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="-1" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </GroupBox>
    </Grid>
</catel:UserControl>
